views:
  - type: table
    name: Table
    filters:
      and:
        - student == "Matheus"
    order:
      - date
      - conteúdo
      - file.name
      - gemini-quiz
    sort:
      - property: date
        direction: DESC
      - property: data
        direction: DESC
    columnSize:
      note.date: 160
      note.conteúdo: 292
      file.name: 128
