views:
  - type: table
    name: Table
    filters:
      and:
        - student == "Myllena"
    order:
      - date
      - conteúdo
      - gemini-quiz
      - file.name
    sort:
      - property: date
        direction: DESC
      - property: data
        direction: DESC
      - property: conteúdo
        direction: ASC
    columnSize:
      note.conteúdo: 412
