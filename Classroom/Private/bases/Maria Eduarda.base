views:
  - type: table
    name: Tabela
    filters:
      and:
        - student == "Maria Eduarda"
    order:
      - date
      - conteúdo
      - file.name
    sort:
      - property: file.name
        direction: DESC
      - property: date
        direction: DESC
      - property: data
        direction: DESC
      - property: conteúdo
        direction: ASC
    limit: 10
    columnSize:
      note.conteúdo: 851
      file.name: 153
