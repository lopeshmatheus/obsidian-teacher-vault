views:
  - type: table
    name: Table
    filters:
      and:
        - file.hasTag("english-file-lesson")
    order:
      - lesson
      - level
      - link
      - title
      - conteúdo
      - file.name
    sort:
      - property: conteúdo
        direction: ASC
    columnSize:
      note.lesson: 63
      note.level: 118
      note.title: 232
