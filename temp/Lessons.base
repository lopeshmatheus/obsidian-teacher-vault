views:
  - type: table
    name: Table
    filters:
      and:
        - file.hasTag("esl-brains-lesson")
    order:
      - lesson
      - level
      - conteúdo
      - title
      - link
      - file.name
    sort:
      - property: level
        direction: ASC
      - property: lesson
        direction: ASC
    columnSize:
      note.lesson: 74
      note.level: 61
      note.conteúdo: 447
      note.title: 225
      note.link: 483
