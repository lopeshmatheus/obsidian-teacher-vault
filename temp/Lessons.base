properties:
  note.link:
    displayName: link
views:
  - type: table
    name: Table
    filters:
      and:
        - file.hasTag("esl-brains-lesson")
        - '!file.inFolder("Templates")'
    groupBy:
      property: level
      direction: ASC
    order:
      - lesson
      - level
      - title
      - conteúdo
      - file.name
    sort:
      - property: lesson
        direction: ASC
      - property: link
        direction: ASC
      - property: level
        direction: ASC
      - property: conteúdo
        direction: ASC
    columnSize:
      note.lesson: 64
      note.level: 51
      note.title: 309
      note.conteúdo: 880
