views:
  - type: table
    name: Table
    filters:
      and:
        - student == "Rafael Visnhieski"
    order:
      - date
      - file.name
      - conteúdo
    sort:
      - property: date
        direction: DESC
    columnSize:
      note.date: 158
      note.material: 116
      note.level: 103
