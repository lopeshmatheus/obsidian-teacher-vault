views:
  - type: table
    name: Table
    filters:
      and:
        - student == "Rafael Visnhieski"
    order:
      - date
      - conteúdo
      - file.name
    sort:
      - property: date
        direction: DESC
      - property: conteúdo
        direction: DESC
    columnSize:
      note.date: 158
      note.conteúdo: 971
