views:
  - type: table
    name: Table
    filters:
      and:
        - file.hasTag("private")
    order:
      - quiz
      - title
      - date
      - file.name
      - gemini-quiz
    sort:
      - property: date
        direction: DESC
    limit: 20
    columnSize:
      note.title: 146
      note.date: 127
      note.quiz: 78
