views:
  - type: table
    name: Table
    filters:
      and:
        - Alunos == ["Patricia"]
    order:
      - date
      - material
      - conteúdo
      - file.name
    sort:
      - property: date
        direction: DESC
      - property: file.name
        direction: ASC
    columnSize:
      note.material: 137
      note.conteúdo: 300
