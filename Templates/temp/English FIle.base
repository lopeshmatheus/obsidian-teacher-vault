views:
  - type: table
    name: Table
    filters:
      and:
        - file.hasTag("english-file-lesson")
    order:
      - lesson
      - level
      - conteúdo
      - grammar
      - gemini-lesson
      - vocabulary
      - file.name
    sort:
      - property: lesson
        direction: ASC
      - property: level
        direction: DESC
      - property: conteúdo
        direction: ASC
    columnSize:
      note.lesson: 101
      note.level: 190
      note.gemini-lesson: 152
      note.conteúdo: 272
